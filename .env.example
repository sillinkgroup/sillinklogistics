# Recommended for Vercel production MySQL
DB_DRIVER=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=sillink
DB_USER=your-user
DB_PASS=your-password
# Or use a single connection URL:
# DATABASE_URL=mysql://user:password@host:3306/sillink

# Local demo uses SQLite automatically when DB_DRIVER=sqlite
SQLITE_PATH=/tmp/sillink.sqlite
